DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine
UPLOAD_DIR=./uploads

# Chat provider: auto | claude | openai | ollama
# auto = Claude (if key) → OpenAI (if key) → Ollama
# claude/openai = primary external provider, then Ollama when fallback is enabled
AI_PROVIDER=auto

# Fall back to Ollama when the primary chat provider fails (default: true)
AI_CHAT_FALLBACK_OLLAMA=true

# Embedding provider: auto | ollama | openai (Claude has no embedding API)
# auto = Ollama → OpenAI → hash fallback
AI_EMBEDDING_PROVIDER=auto

# Fall back to Ollama when the primary embedding provider fails (default: true)
AI_EMBEDDING_FALLBACK_OLLAMA=true

# Ollama (local, no API usage limits)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Pull with: ollama pull llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Anthropic Claude (when AI_PROVIDER=claude or auto with key set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (when AI_PROVIDER=openai or auto with key set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# nomic-embed-text uses 768 dimensions; OpenAI text-embedding-3-small uses 1536
EMBEDDING_DIMENSIONS=768

# Pages of contract text sent to the LLM for metadata extraction (default 5)
EXTRACTION_MAX_PAGES=5

# How many pages to scan when picking metadata-rich content (default 25)
EXTRACTION_SCAN_PAGES=25

# Store full LLM prompt text in extraction trace (default: preview only)
EXTRACTION_TRACE_FULL=false
