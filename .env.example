DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine
UPLOAD_DIR=./uploads

# AI provider: auto (Ollama first, then OpenAI, then heuristic), ollama, or openai
AI_PROVIDER=auto

# Ollama (local, no API usage limits)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (optional fallback or primary when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# nomic-embed-text uses 768 dimensions; OpenAI text-embedding-3-small uses 1536
EMBEDDING_DIMENSIONS=768

# Pages of contract text sent to the LLM for metadata extraction (default 3)
EXTRACTION_MAX_PAGES=3

# How many pages to scan when picking metadata-rich content (default 25)
EXTRACTION_SCAN_PAGES=25
